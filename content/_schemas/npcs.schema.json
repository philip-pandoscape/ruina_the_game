          "type": "number"
        },
        "d": {
          "type": "number"
        },
        "arm": {
          "type": "number"
        },
        "shirt": {
          "type": "string"
        },
        "rolled": {
          "type": "boolean"
        },
        "pants": {
          "type": "string"
        },
        "boots": {
          "type": "string"
        },
        "hair": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "beard": {
          "type": "string"
        },
        "rest": {
          "type": "object"
        },
        "free": {
          "type": "array"
        },
        "sleeve": {
          "type": "string"
        },
        "hunch": {
          "type": "number"
        },
        "skirt": {
          "type": "string"
