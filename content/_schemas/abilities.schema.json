    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "desc": {
      "type": "string"
    },
    "tags": {
      "type": "array"
    },
    "target": {
      "type": "string"
    },
    "castFrames": {
      "type": "number"
    },
    "cooldownFrames": {
      "type": "number"
    },
    "mpCost": {
      "type": "number"
    },
    "castPose": {
