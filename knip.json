{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.ts",
    "src/library/main.ts",
    "src/render/detail/animations.ts",
    "src/render/detail/harness.ts",
    "src/render/detail/retargetView.ts",
    "src/render/models/harness.ts",
    "src/render/village/viewer.ts",
    "src/species/harness.ts",
    "design/bible.ts",
    "design/ui.ts",
    "tests/**/*.{test,spec}.ts",
    "tools/**/*.{mjs,ts}",
    "*.config.ts"
  ],
  "project": [
    "src/**/*.ts",
    "design/**/*.ts",
    "tests/**/*.ts",
    "tools/**/*.{mjs,ts}"
  ],
  "ignore": [
    "tools/refactor/moves-lib.d.mts"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [
    "say"
  ]
}
